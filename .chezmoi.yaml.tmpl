{{- $hostChoices := list "abakus" "chuebel" "abacus" -}}
{{- $host := promptChoiceOnce . "host" "Host profile?" $hostChoices .chezmoi.hostname -}}

data:
  host: {{ $host }}
  wm: {{ if eq $host "abakus" }}hyprland{{ else }}i3{{ end }}
  workspace: {{ if eq $host "abakus" }}private{{ else }}work{{ end }}
{{- if eq .chezmoi.os "windows" }}

cd:
  command: bash
  args:
    - -i

env:
  CHERE_INVOKING: "1"
{{- end }}
