[user]
{{ if eq .workspace "private" -}}
    name = mi-b
    email = mikebaumann@bluewin.ch
{{ else -}}
    name = mib
    email = michael.baumann@helbling.ch
{{ end -}}

[alias]
    st = status --short --branch
    lg = log --oneline --graph --decorate --all
    last = log -1 HEAD --stat
    unstage = restore --staged
    diffs = diff --staged
    pushf = push --force-with-lease --force-if-includes
    amend = commit --amend --no-edit
    branches = branch --sort=-committerdate
    recent = for-each-ref --sort=-committerdate refs/heads/ --format='%(refname:short) %(committerdate:relative)'

[core]
    autocrlf = input

[diff]
  algorithm = histogram

[init]
    defaultBranch = main

[column]
    ui = auto

[branch]
    sort = -committerdate

[pull]
    rebase = true

[merge]
    conflictStyle = zdiff3

[rebase]
    autosquash = true

[rerere]
    enabled = true
    autoUpdate = true

[diff]
    algorithm = histogram
    colorMoved = default

[fetch]
    prune = true

[push]
    recurseSubmodules = check
    autoSetupRemote = true
    useForceIfIncludes = true

[submodule]
    recurse = true

[transfer]
    fsckObjects = true

[tag]
    sort = version:refname
