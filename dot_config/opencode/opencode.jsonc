{
  "$schema": "https://opencode.ai/config.json",

  // Default model
  "model": "anthropic/claude-sonnet-4-6",

  // Global instructions — loaded into every session
  "instructions": ["AGENTS.md"],

  // Permissions
  "permission": {
    // File operations: allow by default
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",

    // Bash: allow git read-only and common dev tools, ask for the rest
    "bash": {
      "git *": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "uv *": "allow",
      "uvx *": "allow",
      "docker *": "allow",
      "docker compose *": "allow",
      "ruff *": "allow",
      "prettier *": "allow",
      "markdownlint-cli2 *": "allow",
      "shfmt *": "allow",
      "bash scripts/*": "allow",
      "pytest *": "allow",
      "ls *": "allow",
      "ls": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "find *": "allow",
      "tree *": "allow",
      "tree": "allow",
      "wc *": "allow",
      "which *": "allow",
      "env": "allow",
      "env *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "realpath *": "allow",
      "dirname *": "allow",
      "basename *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "diff *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "jq *": "allow",
      "yq *": "allow",
      "mkdir *": "allow",
      "rm *": "ask",
      "*": "ask"
    },

    // Never touch secrets directories
    "external_directory": {
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.config/opencode/**": "ask",
      "/tmp/opencode/**": "allow",
      "*": "ask"
    }
  },

  // Per-agent overrides
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "git commit *": "ask"
        }
      }
    }
  }
}
