{
  "$schema": "https://opencode.ai/config.json",

  // Default model
  "model": "anthropic/claude-sonnet-4-6",

  // Global instructions — loaded into every session
  "instructions": ["AGENTS.md"],

  // Permissions
  "permission": {
    // Direct file reads are allowed by default, but environment files require
    // confirmation. Shell and search tools have their own permission rules.
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
    },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",

    // Bash: ask by default, then allow explicit read-only commands.
    "bash": {
      "*": "ask",

      "git diff *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git tag": "allow",
      "git tag *": "allow",

      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "which": "allow",
      "which *": "allow",
      "rg": "allow",
      "rg *": "allow",
      "jq *": "allow",
      "yq *": "allow",
      "realpath *": "allow",
      "dirname *": "allow",
      "basename *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "date": "allow",
      "date *": "allow",
      "whoami": "allow",
      "id": "allow",
      "id *": "allow",
      "hostname": "allow",
      "uname *": "allow",

      "chezmoi diff *": "allow",
      "chezmoi managed *": "allow",
      "chezmoi status *": "allow",
      "chezmoi unmanaged *": "allow",
      "chezmoi verify *": "allow",
      "chezmoi cat *": "allow",
      "chezmoi data *": "allow",
      "chezmoi doctor *": "allow",
      "chezmoi dump *": "allow",
      "chezmoi execute-template *": "allow",
      "chezmoi ignored *": "allow",
      "chezmoi list *": "allow",
      "chezmoi source-path *": "allow",
      "chezmoi state *": "allow",
      "chezmoi target-path *": "allow",
    },

    // External paths use OpenCode's ask-by-default baseline. Put narrower
    // rules last because the last matching permission wins.
    "external_directory": {
      "~/.config/opencode/**": "ask",
      "~/.gnupg/**": "deny",
      "~/.ssh/**": "deny",
    },
  },
}
