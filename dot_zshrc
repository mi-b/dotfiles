export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="agnoster"
HIST_STAMPS="yyyy-mm-dd"
source $ZSH/oh-my-zsh.sh

plugins=(git)
plugins+=(zsh-vi-mode)

export ZVM_VI_EDITOR=nvim
export EDITOR="/usr/bin/nvim"
export LANG=en_GB.UTF-8
export PATH="$HOME/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"

alias astronvim='NVIM_APPNAME=nvim-astro nvim'
alias nvim-typecraft='NVIM_APPNAME=nvim-typecraft nvim'
alias nvs='cd ~/.config/nvim/ && nvim'
alias bat='batcat'

# Set up fzf key bindings and fuzzy completion
source <(fzf --zsh)

# Source brew
test -d ~/.linuxbrew && eval "$(~/.linuxbrew/bin/brew shellenv)"
test -d /home/linuxbrew/.linuxbrew && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"


export PATH="$HOME/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export EDITOR="/usr/bin/nvim"

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}


ff() { find -type f | fzf -m --preview='batcat --color=always {}'; }
fd() { find -type d | fzf ; }

fn() { fzf -m --preview='batcat --color=always {}' --bind 'enter:become(nvim {+})'; }
ffn() { find -type f | fzf --bind 'enter:become(nvim {})'; }
fdn() { find -type d | fzf --preview='batcat --color=always {}' --bind 'enter:become(nvim {})'; }

source <(fzf --zsh)

test -d ~/.linuxbrew && eval "$(~/.linuxbrew/bin/brew shellenv)"
test -d /home/linuxbrew/.linuxbrew && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

# Use gnome-tweaks to switch ctrl and caps
# setxkbmap -option ctrl:nocaps
#
eval "$(zoxide init zsh)"
