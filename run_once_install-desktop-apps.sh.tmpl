{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash

set -eu

TMP_FILE=""
cleanup() {
    if [ -n "$TMP_FILE" ] && [ -f "$TMP_FILE" ]; then
        rm -f "$TMP_FILE"
    fi
}
trap cleanup EXIT

# ---- Check if anything needs installing ----

missing=0
for cmd in gimp inkscape vlc code firefox google-chrome; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        missing=1
        break
    fi
done

if [ "$missing" -eq 0 ]; then
    echo "Desktop applications already installed."
    exit 0
fi

echo "Updating package lists for apt"
sudo apt-get update

# ---- APT desktop apps ----

echo "Installing desktop applications"
sudo apt-get install -y \
    gimp \
    inkscape \
    vlc

# ---- VS Code (requires external repo) ----

if ! command -v code >/dev/null 2>&1; then
    echo "Installing VS Code..."
    sudo apt-get -y install wget gpg
    wget -qO- https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > packages.microsoft.gpg
    sudo install -D -o root -g root -m 644 packages.microsoft.gpg /etc/apt/keyrings/packages.microsoft.gpg
    echo "deb [arch=amd64,arm64,armhf signed-by=/etc/apt/keyrings/packages.microsoft.gpg] https://packages.microsoft.com/repos/code stable main" \
        | sudo tee /etc/apt/sources.list.d/vscode.list >/dev/null
    rm -f packages.microsoft.gpg
    sudo apt-get update
    sudo apt-get install -y code
else
    echo "VS Code already installed."
fi

# ---- Browsers ----

if ! command -v firefox >/dev/null 2>&1; then
    echo "Installing Firefox..."
    sudo apt-get install -y firefox
else
    echo "Firefox already installed."
fi

if ! command -v google-chrome >/dev/null 2>&1; then
    echo "Installing Google Chrome..."
    TMP_FILE="$(mktemp)"
    curl -L https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb -o "$TMP_FILE"
    sudo dpkg -i "$TMP_FILE" || true
    sudo apt-get -f install -y
else
    echo "Google Chrome already installed."
fi
{{ end }}
