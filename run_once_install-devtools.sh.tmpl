{{- if and (eq .chezmoi.os "linux") .install.devtools -}}
#!/usr/bin/env bash

set -eu

missing=0
for cmd in batcat curl ffmpeg fzf git git-lfs htop jq nvim node npm rg tmux unzip zoxide; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        missing=1
        break
    fi
done

if [ "$missing" -eq 0 ] && command -v starship >/dev/null 2>&1; then
    echo "Development tools already installed."
    exit 0
fi

echo "Updating package lists for apt"
sudo apt-get update

echo "Installing development tools"
sudo apt-get install -y \
    bat \
    curl \
    ffmpeg \
    fzf \
    git \
    git-lfs \
    grep \
    htop \
    jq \
    nodejs \
    npm \
    poppler-utils \
    python3-pip \
    python3-venv \
    ripgrep \
    tmux \
    unzip \
    woff2 \
    zoxide \
    7zip

git lfs install

if ! command -v starship >/dev/null 2>&1; then
    echo "Installing starship..."
    sh -c "$(curl -fsSL https://starship.rs/install.sh)" -- --yes -b "$HOME/.local/bin"
else
    echo "Starship already installed."
fi
{{ end }}
