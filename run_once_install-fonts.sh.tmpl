{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash

set -e
set -u

TMP_DIR=""
function cleanup() {
    if [[ -d "$TMP_DIR" ]]; then
        rm -rf "$TMP_DIR"
    fi
}

trap cleanup EXIT

FONT_DIR="$HOME/.fonts"
FIRA_URL="https://github.com/tonsky/FiraCode/releases/download/6.2/Fira_Code_v6.2.zip"
FIRA_FONT="$FONT_DIR/FiraCode-Regular.ttf"

# Skip download if one Fira Code font already exists
if [[ -f "$FIRA_FONT" ]]; then
    echo "Fira Code already installed in $FONT_DIR"
    exit 0
fi

# Create font directory
mkdir -p "$FONT_DIR"

# Temp directory for download and unzip
TMP_DIR=$(mktemp -d)

# Download and unzip Fira Code
curl -L "$FIRA_URL" -o "$TMP_DIR/fira.zip"
unzip -q "$TMP_DIR/fira.zip" -d "$TMP_DIR"

# Copy TTF fonts
cp "$TMP_DIR/ttf/"*.ttf "$FONT_DIR/"

# Refresh font cache
fc-cache -fv "$FONT_DIR"

echo "Fira Code fonts installed to $FONT_DIR"

{{ end }}
