#!/usr/bin/env bash

set -eu

# Trigger rebuild when any Home Manager config file changes.
# flake.nix hash: {{ include "dot_config/home-manager/flake.nix" | sha256sum }}
{{ range glob ".config/home-manager/modules/**/*.nix" -}}
{{ $src := replace ".config/" "dot_config/" . -}}
# {{ $src }}: {{ include $src | sha256sum }}
{{ end -}}
{{ range glob ".config/home-manager/hosts/*.nix" -}}
{{ $src := replace ".config/" "dot_config/" . -}}
# {{ $src }}: {{ include $src | sha256sum }}
{{ end -}}

echo "Applying Home Manager configuration..."

# Source Nix environment if not already available.
if ! command -v nix >/dev/null 2>&1; then
    if [ -f /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
        . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
    else
        echo "ERROR: Nix not found. Run bootstrap first." >&2
        exit 1
    fi
fi

# --impure is required for nixGL Nvidia wrappers (they probe the system driver).
# NIXPKGS_ALLOW_UNFREE is needed because nixGL uses its own nixpkgs pin
# which does not inherit our allowUnfree config.
# Suppress "Nix search path entry … does not exist" warning.
# Determinate Nix deprecates channels; the symlink target doesn't exist.
export NIX_PATH=""
export NIXPKGS_ALLOW_UNFREE=1

if command -v home-manager >/dev/null 2>&1; then
    home-manager switch --impure --flake ~/.config/home-manager
else
    nix run home-manager/master -- switch --impure --flake ~/.config/home-manager
fi

echo "Home Manager applied successfully."
