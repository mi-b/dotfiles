{{- if and (eq .chezmoi.os "linux") .install.devtools -}}
#!/usr/bin/env bash

set -eu

# ---------------------------------------------------------------------------
# Helper: install a binary from a GitHub release archive.
# Usage: install_github_binary <cmd> <version> <url> <extract_cmd>
# ---------------------------------------------------------------------------

install_github_binary() {
    local cmd="$1" version="$2" url="$3" extract_cmd="$4"

    if command -v "$cmd" >/dev/null 2>&1; then
        echo "$cmd already installed."
        return 0
    fi

    echo "Installing $cmd $version..."
    local tmpdir
    tmpdir="$(mktemp -d)"
    trap 'rm -rf "$tmpdir"' RETURN

    curl -fsSL "$url" -o "$tmpdir/archive"
    eval "$extract_cmd"
}

# ---------------------------------------------------------------------------
# Architecture detection (run once, reuse everywhere).
# ---------------------------------------------------------------------------

ARCH="$(uname -m)"

# ---------------------------------------------------------------------------
# APT packages.
# ---------------------------------------------------------------------------

echo "Updating package lists for apt"
sudo apt-get update

echo "Installing development tools"
sudo apt-get install -y \
    7zip \
    bat \
    curl \
    direnv \
    fd-find \
    ffmpeg \
    file \
    fzf \
    git \
    git-delta \
    git-lfs \
    grep \
    htop \
    imagemagick \
    jq \
    latexmk \
    nodejs \
    pandoc \
    podman \
    poppler-utils \
    python3-pip \
    python3-venv \
    ripgrep \
    tmux \
    unzip \
    woff2 \
    zoxide

{{ if ne .wm "hyprland" -}}
sudo apt-get install -y xclip
{{ end -}}

git lfs install

# ---------------------------------------------------------------------------
# tree-sitter CLI (GitHub release, gzipped binary).
# ---------------------------------------------------------------------------

ts_version="v0.26.9"
case "$ARCH" in
    x86_64)         ts_arch="x64"  ;;
    aarch64|arm64)  ts_arch="arm64" ;;
    armv7l|armv6l)  ts_arch="arm"  ;;
    *)              ts_arch="" ;;
esac
if [ -n "$ts_arch" ]; then
    ts_url="https://github.com/tree-sitter/tree-sitter/releases/download/${ts_version}/tree-sitter-linux-${ts_arch}.gz"
    install_github_binary tree-sitter "$ts_version" "$ts_url" \
        'gunzip -c "$tmpdir/archive" > "$HOME/.local/bin/tree-sitter" && chmod +x "$HOME/.local/bin/tree-sitter"'
fi

# ---------------------------------------------------------------------------
# resvg (GitHub release, tarball) — SVG rendering, optional dep for yazi.
# ---------------------------------------------------------------------------

resvg_version="v0.47.0"
if [ "$ARCH" = "x86_64" ]; then
    resvg_url="https://github.com/linebender/resvg/releases/download/${resvg_version}/resvg-linux-x86_64.tar.gz"
    install_github_binary resvg "$resvg_version" "$resvg_url" \
        'tar -xzf "$tmpdir/archive" -C "$tmpdir" && sudo install -m 755 "$tmpdir/resvg" /usr/local/bin/resvg'
fi

# ---------------------------------------------------------------------------
# starship prompt (official installer).
# ---------------------------------------------------------------------------

if ! command -v starship >/dev/null 2>&1; then
    echo "Installing starship..."
    sh -c "$(curl -fsSL https://starship.rs/install.sh)" -- --yes -b "$HOME/.local/bin"
else
    echo "starship already installed."
fi

# ---------------------------------------------------------------------------
# uv — Python package manager (official installer).
# ---------------------------------------------------------------------------

if ! command -v uv >/dev/null 2>&1; then
    echo "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
else
    echo "uv already installed."
fi

# ---------------------------------------------------------------------------
# yazi + ya — terminal file manager and CLI companion (GitHub release).
# Uses musl build for broader glibc compatibility.
# ---------------------------------------------------------------------------

yazi_version="v26.5.6"
case "$ARCH" in
    x86_64)   yazi_arch="x86_64"  ;;
    aarch64)  yazi_arch="aarch64" ;;
    *)        yazi_arch="" ;;
esac
if [ -n "$yazi_arch" ]; then
    yazi_dir="yazi-${yazi_arch}-unknown-linux-musl"
    yazi_url="https://github.com/sxyazi/yazi/releases/download/${yazi_version}/${yazi_dir}.zip"
    install_github_binary yazi "$yazi_version" "$yazi_url" \
        'unzip -q "$tmpdir/archive" -d "$tmpdir" && sudo install -m 755 "$tmpdir/'"${yazi_dir}"'/yazi" /usr/local/bin/yazi && install -m 755 "$tmpdir/'"${yazi_dir}"'/ya" "$HOME/.local/bin/ya"'
fi

# ---------------------------------------------------------------------------
# lazygit — terminal UI for git (GitHub release).
# ---------------------------------------------------------------------------

lazygit_version="0.62.2"
case "$ARCH" in
    x86_64)   lazygit_arch="x86_64" ;;
    aarch64)  lazygit_arch="arm64"   ;;
    *)        lazygit_arch="" ;;
esac
if [ -n "$lazygit_arch" ]; then
    lazygit_url="https://github.com/jesseduffield/lazygit/releases/download/v${lazygit_version}/lazygit_${lazygit_version}_Linux_${lazygit_arch}.tar.gz"
    install_github_binary lazygit "$lazygit_version" "$lazygit_url" \
        'tar -xzf "$tmpdir/archive" -C "$tmpdir" && sudo install -m 755 "$tmpdir/lazygit" /usr/local/bin/lazygit'
fi
{{ end }}
