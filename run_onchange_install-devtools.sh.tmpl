{{- if and (eq .chezmoi.os "linux") .install.devtools -}}
#!/usr/bin/env bash

set -eu

install_tree_sitter() {
    local version arch asset url tmpdir

    version="v0.26.9"
    case "$(uname -m)" in
        x86_64)
            arch="x64"
            ;;
        aarch64|arm64)
            arch="arm64"
            ;;
        armv7l|armv6l)
            arch="arm"
            ;;
        *)
            printf '%s\n' "Unsupported architecture for tree-sitter: $(uname -m)" >&2
            return 1
            ;;
    esac

    asset="tree-sitter-linux-${arch}.gz"
    url="https://github.com/tree-sitter/tree-sitter/releases/download/${version}/${asset}"
    tmpdir="$(mktemp -d)"
    trap 'rm -rf "$tmpdir"' RETURN

    mkdir -p "$HOME/.local/bin"
    curl -fsSL "$url" -o "$tmpdir/tree-sitter.gz"
    gunzip -c "$tmpdir/tree-sitter.gz" > "$HOME/.local/bin/tree-sitter"
    chmod +x "$HOME/.local/bin/tree-sitter"
}

echo "Updating package lists for apt"
sudo apt-get update

echo "Installing development tools"
sudo apt-get install -y \
    bat \
    curl \
    direnv \
    ffmpeg \
    fzf \
    git \
    git-lfs \
    grep \
    htop \
    jq \
    latexmk \
    nodejs \
    poppler-utils \
    python3-pip \
    python3-venv \
    ripgrep \
    tmux \
    unzip \
    woff2 \
    zoxide \
    7zip

git lfs install

echo "Installing tree-sitter CLI..."
install_tree_sitter

if ! command -v starship >/dev/null 2>&1; then
    echo "Installing starship..."
    sh -c "$(curl -fsSL https://starship.rs/install.sh)" -- --yes -b "$HOME/.local/bin"
else
    echo "Starship already installed."
fi

if ! command -v uv >/dev/null 2>&1; then
    echo "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
else
    echo "uv already installed."
fi

if ! command -v yazi >/dev/null 2>&1; then
    echo "Installing yazi..."
    yazi_version="v26.5.6"
    case "$(uname -m)" in
        x86_64)   yazi_arch="x86_64" ;;
        aarch64)  yazi_arch="aarch64" ;;
        *)
            printf '%s\n' "Unsupported architecture for yazi: $(uname -m)" >&2
            exit 1
            ;;
    esac
    yazi_asset="yazi-${yazi_arch}-unknown-linux-gnu.zip"
    yazi_url="https://github.com/sxyazi/yazi/releases/download/${yazi_version}/${yazi_asset}"
    yazi_tmpdir="$(mktemp -d)"
    curl -fsSL "$yazi_url" -o "$yazi_tmpdir/yazi.zip"
    unzip -q "$yazi_tmpdir/yazi.zip" -d "$yazi_tmpdir"
    sudo install -m 755 "$yazi_tmpdir/yazi-${yazi_arch}-unknown-linux-gnu/yazi" /usr/local/bin/yazi
    rm -rf "$yazi_tmpdir"
else
    echo "yazi already installed."
fi
{{ end }}
