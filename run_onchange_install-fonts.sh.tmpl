{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash

set -e
set -u

TMP_DIR=""
function cleanup() {
    if [[ -d "$TMP_DIR" ]]; then
        rm -rf "$TMP_DIR"
    fi
}

trap cleanup EXIT

# Install system font packages
sudo apt-get install -y fonts-noto fonts-firacode

FONT_DIR="$HOME/.local/share/fonts"
FIRA_NERD_URL="https://github.com/ryanoasis/nerd-fonts/releases/download/v3.4.0/FiraCode.zip"
FIRA_NERD_GLOB="$FONT_DIR/*FiraCode*Nerd*Font*.ttf"

# Skip download if one FiraCode Nerd Font already exists
if compgen -G "$FIRA_NERD_GLOB" > /dev/null; then
    echo "FiraCode Nerd Font already installed in $FONT_DIR"
    exit 0
fi

# Create font directory
mkdir -p "$FONT_DIR"

# Temp directory for download and unzip
TMP_DIR=$(mktemp -d)

# Download and unzip FiraCode Nerd Font
curl -L "$FIRA_NERD_URL" -o "$TMP_DIR/fira-nerd.zip"
unzip -q "$TMP_DIR/fira-nerd.zip" -d "$TMP_DIR"

# Copy TTF fonts
cp "$TMP_DIR/"*.ttf "$FONT_DIR/"

# Refresh font cache
fc-cache -fv "$FONT_DIR"

echo "FiraCode Nerd Font installed to $FONT_DIR"

{{ end }}
