#!/usr/bin/env bash
# Install Hyprland system-level packages from the cppiber PPA.
#
# Hyprland runs from the PPA (proper Ubuntu GPU/session integration).
# Configuration is generated by Home Manager as hyprlang and loaded
# via the --config flag to bypass Hyprland's Lua-first auto-detection.
# hash: {{ include "dot_config/home-manager/modules/desktop/hyprland/hyprland.nix" | sha256sum }}

set -eu

sudo apt-get install -y software-properties-common
sudo add-apt-repository -y ppa:cppiber/hyprland
sudo apt-get update
sudo apt-get install -y \
    hyprland \
    xdg-desktop-portal-hyprland \
    xdg-desktop-portal \
    hyprlock \
    qtwayland5 \
    qt6-wayland

# Point the Wayland session entry at a wrapper that loads the HM-generated
# hyprlang config, bypassing PPA Hyprland's Lua-first auto-detection.
sudo tee /usr/local/bin/start-hyprland-hm > /dev/null << 'SCRIPT'
#!/bin/sh
exec /usr/bin/start-hyprland -- --config "$HOME/.config/hypr/hyprland.conf"
SCRIPT
sudo chmod +x /usr/local/bin/start-hyprland-hm

sudo tee /usr/share/wayland-sessions/hyprland.desktop > /dev/null << 'EOF'
[Desktop Entry]
Name=Hyprland
Comment=An intelligent dynamic tiling Wayland compositor
Exec=/usr/local/bin/start-hyprland-hm
Type=Application
DesktopNames=Hyprland
Keywords=tiling;wayland;compositor;
EOF
