#!/usr/bin/env bash
# Install Hyprland system-level packages from the cppiber PPA.
#
# Hyprland runs from the PPA (proper Ubuntu GPU/session integration).
# Configuration is generated by Home Manager as Lua (hyprland.lua).
# Hyprland auto-detects the format from the file extension.
# hash: {{ include "dot_config/home-manager/modules/desktop/hyprland/hyprland.nix" | sha256sum }}

set -eu

sudo apt-get install -y software-properties-common
sudo add-apt-repository -y ppa:cppiber/hyprland
sudo apt-get update
sudo apt-get install -y \
    hyprland \
    xdg-desktop-portal-hyprland \
    xdg-desktop-portal \
    xdg-desktop-portal-gtk \
    hyprlock \
    wofi \
    qtwayland5 \
    qt6-wayland

# Clean up the old hyprlang wrapper if it exists — no longer needed.
# Hyprland auto-detects Lua config from ~/.config/hypr/hyprland.lua.
sudo rm -f /usr/local/bin/start-hyprland-hm
# Restore the PPA's original session entry if it was overwritten by
# the old start-hyprland-hm wrapper.
sudo tee /usr/share/wayland-sessions/hyprland.desktop > /dev/null << 'EOF'
[Desktop Entry]
Name=Hyprland
Comment=An intelligent dynamic tiling Wayland compositor
Exec=/usr/bin/start-hyprland
Type=Application
DesktopNames=Hyprland
Keywords=tiling;wayland;compositor;
EOF
