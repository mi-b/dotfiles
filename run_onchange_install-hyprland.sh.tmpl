#!/usr/bin/env bash
# Install Hyprland system-level packages from the cppiber PPA.
# hash: {{ include "dot_config/hypr/hyprland.lua" | sha256sum }}

set -eu

sudo apt-get install -y software-properties-common
sudo add-apt-repository -y ppa:cppiber/hyprland
sudo apt-get update
sudo apt-get install -y \
    hyprland \
    xdg-desktop-portal-hyprland \
    xdg-desktop-portal \
    hyprlock \
    qtwayland5 \
    qt6-wayland
